# Vorlage fuer api-tests/httpyac/.env (cp .env.example .env). Die echte .env wird nie committed.
# Passwoerter und Secrets nie in diese Vorlage eintragen; Werte vom Team (Passwortmanager) holen.
BASE_URL=https://it220209.cloud.htl-leonding.ac.at
KEYCLOAK_TOKEN_URL=https://it220209.cloud.htl-leonding.ac.at/keycloak/realms/indooro/protocol/openid-connect/token
OIDC_CLIENT_ID=indooro-admin-web
OIDC_CLIENT_SECRET=<aus Secret indooro-keycloak-secret, Key admin-web-client-secret>

ADMIN_USERNAME=indooro-admin
ADMIN_PASSWORD=<REPLACE_ME>
REGION_USERNAME=indooro-region
REGION_PASSWORD=<REPLACE_ME>
STORE_USERNAME=indooro-store
STORE_PASSWORD=<REPLACE_ME>

# Testdaten (IDs aus dem jeweiligen System; siehe README.md)
ACTIVE_STORE_ID=<store-uuid>
ACTIVE_BEACON_UUID=<beacon-uuid>
ACTIVE_RECIPE_ID=<recipe-uuid>
REGION_ALLOWED_STORE_ID=<store-uuid>
REGION_FORBIDDEN_STORE_ID=<store-uuid>
STORE_ALLOWED_STORE_ID=<store-uuid>
STORE_FORBIDDEN_STORE_ID=<store-uuid>
RECIPE_SEARCH_QUERY=pasta
TEST_CATEGORY_CODE=999
TEST_CATEGORY_NAME=Test
TEST_PRODUCT_ID=999999
