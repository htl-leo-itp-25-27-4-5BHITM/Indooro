{
  "name": "indooro-pilot-showcase",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Eigenständige, interaktive Indooro-Pilotdemonstration für Supermarktbetreiber (ohne Backend).",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 4317 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "lucide-react": "1.68.0",
    "motion": "12.23.24",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.1.16",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "4.1.16",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.4"
  }
}
