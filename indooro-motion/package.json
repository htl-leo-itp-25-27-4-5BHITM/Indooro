{
  "name": "indooro-motion",
  "version": "1.0.0",
  "description": "Indooro cinematic product film",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@remotion/cli": "4.0.530",
    "@remotion/media": "4.0.530",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.530"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.530",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "typecheck": "tsc --noEmit",
    "audio": "node scripts/generate-audio.mjs",
    "routes:test": "node --import tsx --test src/data/store.test.ts",
    "render:preview": "remotion render IndooroFilm exports/indooro-motion-graphics-preview.mp4 --scale=0.5 --codec=h264 --pixel-format=yuv420p --audio-codec=aac --concurrency=4",
    "render:final": "remotion render IndooroFilm exports/indooro-motion-graphics-final.mp4 --codec=h264 --pixel-format=yuv420p --audio-codec=aac --concurrency=4",
    "render:poster": "remotion still IndooroPoster exports/indooro-poster.png"
  },
  "sideEffects": [
    "*.css"
  ]
}
