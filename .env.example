# Vorlage fuer lokale Entwicklung (docker compose, Backend-Dev).
# Verwendung: cp .env.example .env  und danach die Werte selbst setzen.
# NUR fuer lokale Entwicklung. Nie echte Werte hier eintragen, nie committen.
# Die Platzhalter change-me-<name> muessen vor dem Start ersetzt werden.

# Keycloak (lokal, docker compose)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-kc-bootstrap-admin-password

# Client-Secret des Keycloak-Clients indooro-admin-web.
# Muss identisch mit OIDC_CLIENT_SECRET sein.
KC_ADMIN_WEB_CLIENT_SECRET=change-me-admin-web-client-secret

# Demo-Benutzer im lokalen Realm (indooro-admin, indooro-region, indooro-store)
KC_DEMO_ADMIN_PASSWORD=change-me-kc-demo-admin-password
KC_DEMO_REGION_PASSWORD=change-me-kc-demo-region-password
KC_DEMO_STORE_PASSWORD=change-me-kc-demo-store-password

# Backend (lokal, Quarkus dev)
# Datenbank-Passwort fuer den lokalen PostgreSQL-Container (Benutzer indooro)
DB_PASSWORD=change-me-db-password
# Muss identisch mit KC_ADMIN_WEB_CLIENT_SECRET sein.
OIDC_CLIENT_SECRET=change-me-admin-web-client-secret
